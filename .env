MQTT_BROKER=localhost
MQTT_PORT=1883

# ─── Data Source Toggle ──────────────────────────────────────────
# Controls which data source feeds room/sensors (used by startall.sh):
#   "simulator"  — CSV playback via data_simulator.py  (default)
#   "hardware"   — Group 1 live sensors via hw_bridge.py
#   "both"       — both at once (debugging only — data will mix!)
DATA_SOURCE=hardware

DJANGO_SECRET_KEY='w*o)5i5-#e^7&=!k)4o55$gdlsh((d@to9@6zqya4+j+laozvi'

# ─── ML Model Configuration (plug-and-play) ─────────────────────
# To swap models:
#   1. Change MODEL_ASSET_DIR to the folder with model artifacts
#   2. Change ML_SERVICE_SCRIPT to the service file for that model
#   3. Restart the service
#
# Model A (TE-GRU + LightGBM — original):
#   MODEL_ASSET_DIR=new_ml_model/New folder
#   ML_SERVICE_SCRIPT=workers/ml_service.py
#
# Model B (LightGBM + XGBoost + MH Blend):
#   MODEL_ASSET_DIR=LIGHT_ML_MODEL/model_assets
#   ML_SERVICE_SCRIPT=LIGHT_ML_MODEL/main.py
#
# Model C (TE-GRU + XGBoost + MH — current):
MODEL_ASSET_DIR=model_new_unsure/model_assets
ML_SERVICE_SCRIPT=model_new_unsure/main.py

DECISION_INTERVAL_MINUTES=5

BATTERY_LAG_INTERVAL_SECONDS=30

# ─── EDFI Load Thresholds (Wh) ──────────────────────────────────
# EDFI >= PEAK        → Peak Load     (Smart A / B / C)
# MODERATE <= EDFI    → Moderate Load  (Smart B / C)
# BASELINE <= EDFI    → Baseline Load  (Smart C)
# EDFI < BASELINE     → Very Low       (Smart C)
PEAK_THRESHOLD=60
MODERATE_THRESHOLD=20
BASELINE_THRESHOLD=5

# Sensor averaging window (seconds). The ML model was trained on
# 5-minute averaged readings, so we buffer sensor data and average
# before sending to the model.
SENSOR_AVG_WINDOW_SECONDS=300

# How often to send a real-time prediction (seconds).
# Predictions fire continuously as sensor data arrives, but are
# rate-limited to avoid overloading the ML service.
PREDICTION_RATE_LIMIT_SECONDS=5

# Solar window (24h). Kept for reference / future use.
SOLAR_HOUR_START=11
SOLAR_HOUR_END=16


# ─── Data Simulator ──────────────────────────────────────────────
# Used by: simulation/data_simulator.py
# Base URL of the ML FastAPI prediction service.
ML_API_BASE=http://127.0.0.1:5000



# Max seconds to wait for a prediction on MQTT before timing out.
PREDICTION_TIMEOUT=30



# Minimum seconds to pause between CSV rows (keeps output readable).
#   Set to 0 to go as fast as possible (prediction-paced only).
MIN_ROW_DELAY=3



# Battery drain mode: "consistent" (linear -0.1%/row) or "inconsistent"
#   (randomised fluctuations to stress-test the 3-time battery lag).
BATTERY_DRAIN_MODE=inconsistent




# Starting battery percentage when the simulator boots.
BATTERY_START=100.0



# Minimum battery percentage — drain stops here.
BATTERY_FLOOR=20.0



# ─── ML Prediction API ───────────────────────────────────────────
# Used by: new_ML/new_prediction_api.py
# (No longer needs PREDICTION_INTERVAL_SECONDS — rule engine
#  calls ML directly via HTTP on each decision cycle.)

# ─── Hardware Bridge ─────────────────────────────────────────────
# Used by: workers/hw_bridge.py
# Group 1's MQTT topic (combined environmental + battery payload).
TOPIC_HW_NANO=room/hardware/nano