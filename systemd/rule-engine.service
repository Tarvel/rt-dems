[Unit]
Description=Smart Room Rule Engine (MQTT relay publisher)
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=grandmaster
WorkingDirectory=/home/grandmaster/Documents/project/PROJECT_CODE_4
ExecStart=/home/grandmaster/Documents/project/PROJECT_CODE_4/venv/bin/python3 /home/grandmaster/Documents/project/PROJECT_CODE_4/workers/rule_engine.py
Environment="DB_PATH=/home/grandmaster/Documents/project/PROJECT_CODE_4/room_backend/db.sqlite3"
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
