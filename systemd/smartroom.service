[Unit]
Description=Smart Room Energy Management System (all services)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=pi
WorkingDirectory=/home/pi/PROJECT_CODE
ExecStart=/bin/bash /home/pi/PROJECT_CODE/startall.sh
ExecStop=/bin/kill -SIGINT $MAINPID

# If startall.sh or any of its children crash, restart after 10 seconds
Restart=on-failure
RestartSec=10

# Environment
EnvironmentFile=/home/pi/PROJECT_CODE/.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartroom

[Install]
WantedBy=multi-user.target
